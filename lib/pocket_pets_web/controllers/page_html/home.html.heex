<Layouts.flash_group flash={@flash} />
<main class="min-h-screen bg-zinc-950 text-zinc-100">
  <section class="border-b border-zinc-800 bg-zinc-900">
    <div class="mx-auto grid max-w-6xl gap-8 px-6 py-10 lg:grid-cols-[1.1fr_0.9fr] lg:px-8">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-cyan-300">
          Dispersed Power Hour
        </p>
        <h1 class="mt-3 max-w-3xl text-4xl font-semibold leading-tight text-white sm:text-5xl">
          Pocket pets on Dispersed
        </h1>
        <p class="mt-5 max-w-2xl text-base leading-7 text-zinc-300">
          A tiny Tamagotchi-style LiveView where each pet is a Jido agent with a distinctive
          personality from jido_character. Feed it, play with it, let it nap, and watch its mood
          shift in real time.
        </p>
      </div>

      <div class="rounded-lg border border-zinc-700 bg-zinc-950 p-5">
        <div class="flex items-center justify-between gap-4">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-zinc-300">Fallback</h2>
          <span class="rounded bg-emerald-400 px-2 py-1 text-xs font-semibold text-emerald-950">
            ready
          </span>
        </div>
        <pre
          phx-no-curly-interpolation
          class="mt-4 overflow-x-auto rounded bg-black p-4 text-xs leading-6 text-zinc-200"
        ><code>mix run --no-start -e 'PocketPets.VirtualPet.Script.demo()'</code></pre>
      </div>
    </div>
  </section>

  <section class="mx-auto grid max-w-6xl gap-6 px-6 py-8 lg:grid-cols-2 lg:px-8">
    <div>
      <h2 class="text-xl font-semibold text-white">Best target for tonight</h2>
      <p class="mt-3 text-sm leading-6 text-zinc-300">
        Build one great pet loop first: hunger, energy, joy, mood, and three actions. A minute
        of playful polish beats a wider but flatter agent platform tonight.
      </p>
    </div>

    <div>
      <h2 class="text-xl font-semibold text-white">Stack stance</h2>
      <p class="mt-3 text-sm leading-6 text-zinc-300">
        Critical path: Phoenix LiveView, Jido, jido_character, Jason, and GitHub Actions
        publishing to GHCR. Keep state in memory, skip database queues, and keep the UI fast.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-12 lg:px-8">
    <h2 class="text-xl font-semibold text-white">Agent ideas</h2>
    <div class="mt-5 grid gap-4 md:grid-cols-2">
      <%= for idea <- @ideas do %>
        <article class="rounded-lg border border-zinc-800 bg-zinc-900 p-5">
          <h3 class="text-base font-semibold text-cyan-200">{idea.name}</h3>
          <p class="mt-3 text-sm leading-6 text-zinc-300">{idea.pitch}</p>
          <p class="mt-4 text-sm leading-6 text-zinc-400">{idea.why}</p>
        </article>
      <% end %>
    </div>
  </section>
</main>
